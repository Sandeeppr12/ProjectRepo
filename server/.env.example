NODE_ENV=development
PORT=5000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"
JWT_SECRET=replace-with-a-long-random-secret

# SMTP settings are required to send registration verification codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Digital Vistara <your-sender@gmail.com>

# Twilio SMS settings are also required for registration OTP delivery.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Set either a Twilio phone number or Messaging Service SID.
TWILIO_FROM_NUMBER=+15017122661
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin access is limited to this email. Set ADMIN_PASSWORD temporarily when provisioning:
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
